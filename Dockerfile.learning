FROM node:24.18.0-bookworm-slim@sha256:cb4e8f7c443347358b7875e717c29e27bf9befc8f5a26cf18af3c3dec80e58c5 AS dependencies
WORKDIR /workspace
ENV NPM_CONFIG_STRICT_ALLOW_SCRIPTS=true
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS build
COPY . .
# BuildKitのRUNにもDocker専用asset生成器の判定を明示する。
ARG LOCAL_LEARNING=1
RUN touch /.dockerenv && VITE_LOCAL_LEARNING=$LOCAL_LEARNING BASE_PATH=/ npm run build

FROM node:24.18.0-bookworm-slim@sha256:cb4e8f7c443347358b7875e717c29e27bf9befc8f5a26cf18af3c3dec80e58c5 AS project
WORKDIR /opt
COPY --from=dependencies /workspace/node_modules ./node_modules
COPY scripts/local/project-bootstrap.mjs scripts/local/project-apply.mjs scripts/local/next-project-protocol.mjs scripts/local/next-routing-source.mjs scripts/local/next-data-source.mjs scripts/local/next-form-source.mjs scripts/local/next-production-source.mjs ./
USER 1000:1000
CMD ["node", "/opt/project-bootstrap.mjs"]

FROM node:24.18.0-bookworm-slim@sha256:cb4e8f7c443347358b7875e717c29e27bf9befc8f5a26cf18af3c3dec80e58c5 AS next-project
WORKDIR /opt/next
COPY scripts/content/fixtures/next-author-pilot.json scripts/content/fixtures/next-author-pilot.lock.json ./
RUN node --input-type=module -e "import fs from 'node:fs'; const pilot = JSON.parse(fs.readFileSync('next-author-pilot.json')); fs.writeFileSync('package.json', JSON.stringify(pilot.manifest)); fs.copyFileSync('next-author-pilot.lock.json', 'package-lock.json'); fs.writeFileSync('tsconfig.json', pilot.files['tsconfig.json']);" \
    && npm ci --ignore-scripts --no-audit --no-fund --userconfig /dev/null
WORKDIR /opt
COPY scripts/local/next-project-bootstrap.mjs scripts/local/next-data-backend.mjs scripts/local/next-form-backend.mjs scripts/local/next-form-preview.mjs scripts/local/next-form-cookie.mjs scripts/local/preview-body.mjs scripts/local/next-data-backend-build.mjs scripts/local/project-apply.mjs scripts/local/next-project-protocol.mjs scripts/local/next-routing-source.mjs scripts/local/next-data-source.mjs scripts/local/next-form-source.mjs scripts/local/next-production-source.mjs ./
RUN node /opt/next-data-backend-build.mjs
USER 1000:1000
CMD ["node", "/opt/next-project-bootstrap.mjs"]

FROM node:24.18.0-bookworm-slim@sha256:cb4e8f7c443347358b7875e717c29e27bf9befc8f5a26cf18af3c3dec80e58c5 AS web
WORKDIR /app
COPY --from=build /workspace/dist ./dist
COPY src/core/runtime/pythonLessonProfiles.mjs ./
COPY scripts/local/web.mjs scripts/local/protocol.mjs ./
CMD ["node", "web.mjs"]

FROM node:24.18.0-bookworm-slim@sha256:cb4e8f7c443347358b7875e717c29e27bf9befc8f5a26cf18af3c3dec80e58c5 AS controller
WORKDIR /app
COPY --from=build /workspace/public/generated/content/courses/javascript/index.json ./course-index.json
COPY --from=build /workspace/public/generated/content/courses/python-basics/index.json ./python-course-index.json
COPY --from=build /workspace/public/generated/content/courses/python-practice/index.json ./python-practice-course-index.json
COPY --from=build /workspace/public/generated/content/courses/python-oop/index.json ./python-oop-course-index.json
COPY src/core/runtime/pythonLessonProfiles.mjs ./
COPY scripts/local/controller.mjs scripts/local/protocol.mjs scripts/local/docker-engine.mjs ./
COPY scripts/local/python-profile.mjs scripts/local/python-practice.mjs scripts/local/python-practice.py ./
COPY src/core/runtime/pythonFixedFixtures.mjs ./
COPY src/core/runtime/pythonLessonAnalysis.mjs ./python-lesson-analysis.mjs
COPY src/core/runtime/pythonIterationAnalysis.mjs ./
COPY src/core/runtime/pythonContextAnalysis.mjs ./
COPY src/core/runtime/pythonOopAnalysis.mjs ./
COPY src/core/runtime/pythonObjectProtocolAnalysis.mjs ./
COPY src/core/runtime/pythonDecoratorAnalysis.mjs src/core/runtime/pythonDecoratorFactoryAnalysis.mjs ./
COPY src/core/runtime/pythonDataProjectAnalysis.mjs ./
COPY src/core/runtime/pythonModuleAnalysis.mjs ./pythonModuleAnalysis.mjs
COPY scripts/local/project-protocol.mjs scripts/local/workspace-store.mjs scripts/local/project-engine.mjs scripts/local/resident-workspace.mjs ./
COPY scripts/local/preview-contract.mjs scripts/local/next-data-preview.mjs scripts/local/next-form-preview.mjs scripts/local/next-form-cookie.mjs scripts/local/preview-control.mjs scripts/local/preview-transport.mjs ./
COPY scripts/local/project-grade-engine.mjs scripts/local/next-project-protocol.mjs scripts/local/next-routing-source.mjs scripts/local/next-data-source.mjs scripts/local/next-form-source.mjs scripts/local/next-production-source.mjs scripts/local/next-project-acceptance.mjs scripts/local/native-fixture-digest.mjs ./
CMD ["node", "controller.mjs"]

FROM node:24.18.0-bookworm-slim@sha256:cb4e8f7c443347358b7875e717c29e27bf9befc8f5a26cf18af3c3dec80e58c5 AS preview
WORKDIR /app
COPY src/core/runtime/pythonLessonProfiles.mjs ./
COPY scripts/local/preview-proxy.mjs scripts/local/preview-body.mjs scripts/local/preview-http-response.mjs scripts/local/preview-contract.mjs scripts/local/next-data-preview.mjs scripts/local/next-form-preview.mjs scripts/local/next-form-cookie.mjs scripts/local/protocol.mjs scripts/local/next-project-protocol.mjs scripts/local/next-routing-source.mjs scripts/local/next-data-source.mjs scripts/local/next-form-source.mjs scripts/local/next-production-source.mjs ./
CMD ["node", "preview-proxy.mjs"]

# trusted採点/作者/CI用。Browserを固定し、learner・web・controller imageへ含めない。
FROM mcr.microsoft.com/playwright:v1.61.1-noble@sha256:5b8f294aff9041b7191c34a4bab3ac270157a28774d4b0660e9743297b697e48 AS browser-checks
WORKDIR /workspace
COPY --from=dependencies /usr/local/bin/node /usr/local/bin/node
COPY --from=dependencies /workspace/node_modules/@playwright/test ./node_modules/@playwright/test
COPY --from=dependencies /workspace/node_modules/playwright ./node_modules/playwright
COPY --from=dependencies /workspace/node_modules/playwright-core ./node_modules/playwright-core
COPY --from=dependencies /workspace/node_modules/@axe-core/playwright ./node_modules/@axe-core/playwright
COPY --from=dependencies /workspace/node_modules/axe-core ./node_modules/axe-core
COPY scripts/local ./scripts/local
COPY src/core/runtime/pythonLessonAnalysis.mjs src/core/runtime/pythonLessonProfiles.mjs ./src/core/runtime/
COPY src/core/runtime/pythonModuleAnalysis.mjs ./src/core/runtime/
COPY src/core/runtime/pythonIterationAnalysis.mjs ./src/core/runtime/
COPY src/core/runtime/pythonContextAnalysis.mjs ./src/core/runtime/
COPY src/core/runtime/pythonOopAnalysis.mjs ./src/core/runtime/
COPY src/core/runtime/pythonObjectProtocolAnalysis.mjs ./src/core/runtime/
COPY src/core/runtime/pythonDecoratorAnalysis.mjs src/core/runtime/pythonDecoratorFactoryAnalysis.mjs ./src/core/runtime/
COPY src/core/runtime/pythonDataProjectAnalysis.mjs ./src/core/runtime/
CMD ["node", "scripts/local/preview-browser-acceptance.mjs"]

# 正負Fixtureと通常Lessonの作者検証専用。learner/web/graderへ原稿を含めない。
FROM browser-checks AS next-browser-checks
COPY --from=dependencies /workspace/node_modules/yaml ./node_modules/yaml
COPY --from=dependencies /workspace/node_modules/fflate ./node_modules/fflate
COPY content ./content
CMD ["node", "scripts/local/next-project-browser-acceptance.mjs"]

# Next教材のproduction build診断専用。原稿は実行/管理imageへ含めない。
FROM next-project AS next-content-checks
USER root
WORKDIR /author
COPY --from=dependencies /workspace/node_modules/yaml ./node_modules/yaml
COPY content/next ./content/next
COPY scripts/local/next-build-acceptance.mjs ./
USER 1000:1000
CMD ["node", "next-build-acceptance.mjs"]

# Pythonの通常Lesson検証専用。正負原稿は製品imageへ含めない。
FROM browser-checks AS python-browser-checks
COPY --from=dependencies /workspace/node_modules/yaml ./node_modules/yaml
COPY --from=dependencies /workspace/node_modules/fflate ./node_modules/fflate
COPY --from=dependencies /workspace/node_modules/zod ./node_modules/zod
# 実行後のSource/fixture照合はtrusted検証imageだけが行う。learnerへ原稿を渡さない。
COPY scripts/content ./scripts/content
COPY scripts/release/v2 ./scripts/release/v2
COPY src/core/content ./src/core/content
COPY src/core/persistence/canonicalJson.ts ./src/core/persistence/canonicalJson.ts
COPY src/shared/lib/resolvePublicAsset.ts ./src/shared/lib/resolvePublicAsset.ts
COPY content/python-basics ./content/python-basics
COPY content/python-practice ./content/python-practice
COPY content/python-oop ./content/python-oop
COPY tests/local/python-learning.spec.ts ./tests/local/python-learning.spec.ts
COPY tests/local/python-practice.spec.ts ./tests/local/python-practice.spec.ts
COPY tests/e2e/python-input.spec.ts ./tests/e2e/python-input.spec.ts
COPY tests/e2e/python-module.spec.ts ./tests/e2e/python-module.spec.ts
COPY tests/e2e/python-iteration.spec.ts ./tests/e2e/python-iteration.spec.ts
COPY tests/e2e/python-context.spec.ts ./tests/e2e/python-context.spec.ts
COPY tests/e2e/python-data-project.spec.ts ./tests/e2e/python-data-project.spec.ts
COPY tests/e2e/python-oop.spec.ts ./tests/e2e/python-oop.spec.ts
COPY tests/e2e/helpers/progress.ts tests/e2e/helpers/testBasePath.ts ./tests/e2e/helpers/
COPY tests/e2e/helpers/pythonFixtureCoverage.ts ./tests/e2e/helpers/pythonFixtureCoverage.ts
COPY playwright.python-local.config.ts ./
CMD ["node", "scripts/local/python-browser-acceptance.mjs"]

# Same-source Native learning UI only. Never copied into a learner/controller/web image.
FROM python-browser-checks AS learning-native-checks
COPY content ./content
COPY src/core/runtime/pythonFixedFixtures.mjs ./src/core/runtime/pythonFixedFixtures.mjs
COPY tests/e2e/helpers/manifestLearning.ts ./tests/e2e/helpers/manifestLearning.ts
COPY tests/local/manifest-next-learning.spec.ts ./tests/local/manifest-next-learning.spec.ts
COPY playwright.learning-native.config.ts ./
CMD ["node", "scripts/local/manifest-learning-browser-acceptance.mjs", "chromium"]

# 反復教材の作者Fixture/実object観察専用。配信・learner imageへ原稿を渡さない。
FROM python-browser-checks AS python-iteration-checks
COPY vendor/python/314.0.7 ./vendor/python/314.0.7
CMD ["node", "scripts/local/python-iteration-acceptance.mjs", "--pyodide"]
